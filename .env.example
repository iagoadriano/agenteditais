# ============================================================================
# Configuração do ambiente — copie para .env na raiz do projeto e preencha.
#   cp .env.example .env
# O backend lê este arquivo via backend/config.py (python-dotenv).
# NUNCA commite o .env preenchido.
# ============================================================================

# ── Banco de dados MySQL (obrigatório) ──────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=editais
MYSQL_PASSWORD=
MYSQL_DATABASE=editais

# ── Segurança (obrigatório em produção) ─────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
# Chave Fernet p/ criptografar senhas guardadas (certidões etc.)
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRYPTO_KEY=

# ── CORS / acesso externo ───────────────────────────────────────────────────
# URLs do frontend que podem chamar a API (separadas por vírgula). "*" só em dev.
CORS_ORIGINS=http://localhost:5180

# ── IA — DeepSeek (obrigatório para o chat/agente) ──────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Busca web (opcional — escolha um provedor) ──────────────────────────────
# Opções: duckduckgo (sem chave), brave, serper, serpapi, google_cse
SCRAPE_API=duckduckgo
BRAVE_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ── E-mail / alertas (opcional — necessário p/ notificações por e-mail) ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@seudominio.com.br
CHECK_ALERTAS_INTERVAL=5
CHECK_MONITORAMENTOS_INTERVAL=60

# ── Integrações opcionais ───────────────────────────────────────────────────
CAPSOLVER_API_KEY=
BEC_CACHE_TTL_HOURS=24
COMPRASNET_TIMEOUT=10
MINDSDB_HOST=127.0.0.1
MINDSDB_PORT=47334
MINDSDB_USER=mindsdb
MINDSDB_PASSWORD=

# ── Frontend (variáveis de BUILD — use no comando npm run build) ────────────
# VITE_APP_NAME="MeuNome.IA"            # rebrand: nome exibido no app
# VITE_APP_TAGLINE="Minha descrição"    # subtítulo da tela de login
# VITE_ALLOWED_HOSTS="meudominio.com"   # hosts extras p/ vite dev server
